# Allow-list: only what is named here is tracked. Anything else stays local.
/*
!/.gitignore
!/.github/
!/CHANGELOG.md
!/LICENSE
!/Makefile
!/README.md
!/CITATION.cff
!/MANIFEST.sha256
!/pyproject.toml
!/uv.lock
!/src/
!/tests/
!/tools/
!/paper/
!/logs/
!/evidence/
# v0.6: the run record and the spend of the attacker arms (Amendment 4)
!/STATUS-ATTACKER-2026-11-02.md
!/SPEND-ATTACKER-2026-11-02.md
# v0.7: readings amendment, judge logs, fixture replay, hand-audit labels, external-use docs
!/docs/
!/REGISTER-ISSUE-DRAFT-v2.md

# Paper: the source, the protocol, the current PDF and the frozen v0.3 text and PDF
/paper/*
!/paper/REPORT.md
!/paper/V03-PROTOCOL.md
!/paper/paper.tex
!/paper/figures/
!/paper/ToolEffectBench-v0.3.pdf
!/paper/REPORT-v0.3.md
!/paper/ToolEffectBench-v0.4.pdf
!/paper/ToolEffectBench-v0.5.pdf
!/paper/REPORT-v0.4.md
!/paper/REPORT-v0.5.md
!/paper/ToolEffectBench-v0.6.pdf
!/paper/V05-ATTACKER-AMENDMENT.md
!/paper/V07-READINGS-AMENDMENT.md
!/paper/V07-READINGS-AMENDMENT-tsa/
!/paper/REPORT-v0.6.md
!/paper/ToolEffectBench-v0.7.pdf
# v0.7.1: the paper text under CC BY 4.0 and its Zenodo record
!/paper/ToolEffectBench-v0.7.1.pdf
!/paper/ZENODO-METADATA.md
!/paper/SECOND-READ-v0.7.1.jsonl

# The scored runs behind the paper's tables, and the record of the declined attacker call
/logs/*
!/logs/baseline-*/
!/logs/crafting-*/
!/logs/v4-*/
# v0.6: the 12 scored attacker-arm runs; both crafting folders (of record and void)
# are covered by crafting-* above
!/logs/attacker-*/
!/logs/readings-judge-*/
!/logs/fixture-replay-*/
!/logs/readings-hand-audit-*/
/evidence/*
!/evidence/claude-*/
!/evidence/v4-*/
!/evidence/attacker-*/
!/evidence/fixture-replay-*/
# First pass of the local stronger run; its finished samples are in the resumed log
/logs/v4-qwen3.5-27b-v3-20261031T205459Z/
# Crafting: the in-process stand-in's per-episode SQLite files stay local (crafting is not scored)
/logs/crafting-*/sandboxes-r*/

__pycache__/
*.pyc
.DS_Store
